.page{
  padding:32rpx;
  background:#f7f8f5;
  min-height:100vh;
}

.hero{
  height:220rpx;
  background:#e8f5e9;
  border-radius:32rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  font-size:42rpx;
  font-weight:bold;
}

.main-card,
.section{
  background:#fff;
  border-radius:28rpx;
  padding:30rpx;
  margin-top:24rpx;
}

.title{
  font-size:42rpx;
  font-weight:bold;
  line-height:1.4;
}

.tag{
  display:inline-block;
  margin-top:20rpx;
  background:#e8f5e9;
  color:#2e7d32;
  padding:10rpx 22rpx;
  border-radius:30rpx;
}

.location{
  margin-top:22rpx;
}

.status{
  margin-top:18rpx;
  color:#35a854;
}

.section-title{
  font-size:32rpx;
  font-weight:bold;
  display:block;
  margin-bottom:18rpx;
}

.content{
  color:#555;
  line-height:1.8;
}

.bottom-actions{
  position:fixed;
  bottom:30rpx;
  left:32rpx;
  right:32rpx;
  display:flex;
  gap:20rpx;
}

.bottom-actions button{
  flex:1;
}

.primary{
  background:#35a854;
  color:white;
}
