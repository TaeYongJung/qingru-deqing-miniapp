.page{
  padding:32rpx;
  padding-bottom:150rpx;
  background:#f7f8f5;
  min-height:100vh;
}
.hero,
.contact-hero{
  height:220rpx;
  border-radius:32rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  flex-direction:column;
}
.hero{background:#e8f5e9;font-size:42rpx;font-weight:bold;}
.contact-hero{background:#eaf6ee;color:#216d3d;}
.contact-hero-icon{font-size:52rpx;line-height:1;}
.contact-hero-label{font-size:38rpx;font-weight:bold;margin-top:14rpx;}
.contact-hero-subtitle{font-size:25rpx;margin-top:8rpx;color:#5c7865;}
.main-card,
.section{
  background:#fff;
  border-radius:28rpx;
  padding:30rpx;
  margin-top:24rpx;
}
.title{font-size:42rpx;font-weight:bold;line-height:1.4;}
.tag{
  display:inline-block;
  margin-top:20rpx;
  background:#e8f5e9;
  color:#2e7d32;
  padding:10rpx 22rpx;
  border-radius:30rpx;
}
.location{margin-top:22rpx;color:#555;}
.status{margin-top:18rpx;color:#35a854;}
.section-title{
  font-size:32rpx;
  font-weight:bold;
  display:block;
  margin-bottom:18rpx;
}
.content{color:#555;line-height:1.8;}
.contact-info{padding-bottom:26rpx;}
.contact-row{
  display:flex;
  align-items:center;
  padding:20rpx 0;
  border-bottom:1rpx solid #f0f0f0;
}
.contact-label{color:#888;width:150rpx;}
.contact-value{color:#247346;font-weight:600;flex:1;}
.contact-note{font-size:23rpx;color:#999;line-height:1.6;margin-top:18rpx;}
.bottom-actions{
  position:fixed;
  bottom:30rpx;
  left:32rpx;
  right:32rpx;
  display:flex;
  gap:20rpx;
}
.bottom-actions button{flex:1;}
.bottom-actions .full{width:100%;}
.primary{background:#35a854;color:white;}