<view class="page">
  <view class="hero">
    <text>青年机会</text>
  </view>

  <view class="main-card">
    <view class="title">{{item.title}}</view>
    <view class="tag">{{item.type}}</view>
    <view class="location">📍 {{item.location}}</view>
    <view class="status">{{item.status}}</view>
  </view>

  <view class="section">
    <text class="section-title">关于机会</text>
    <view class="content">{{item.desc}}</view>
  </view>

  <view class="section">
    <text class="section-title">适合青年</text>
    <view class="content">{{item.target}}</view>
  </view>

  <view class="section">
    <text class="section-title">你将获得</text>
    <view class="content">{{item.benefit}}</view>
  </view>

  <view class="section">
    <text class="section-title">咨询渠道</text>
    <view class="content">{{item.phone}}</view>
  </view>

  <view class="bottom-actions">
    <button>⭐ 收藏</button>
    <button class="primary">立即咨询</button>
  </view>
</view>
