<view class="page">
  <view class="hero">
    <image class="hero-image" src="/images/deqing-home-banner.svg" mode="aspectFill"></image>
    <view class="hero-overlay"></view>
    <view class="hero-content">
      <view class="eyebrow">DEQING · YOUTH IN THE COUNTRYSIDE</view>
      <view class="hero-title">青入德清</view>
      <view class="hero-subtitle">青年入乡机会与资源平台</view>
      <view class="hero-desc">连接青年与德清乡村，让每一次选择都有方向。</view>
    </view>
    <view class="hero-slogan">
      <text>发现机会</text>
      <text class="dot">·</text>
      <text>扎根乡村</text>
      <text class="dot">·</text>
      <text>共创未来</text>
    </view>
  </view>

  <view class="section-head">
    <view>
      <view class="section-title">你想从哪里开始？</view>
      <view class="section-desc">找到适合你的入乡入口</view>
    </view>
  </view>

  <view class="entry-list">
    <view class="entry entry-green" data-type="项目机会" bindtap="goList">
      <view class="entry-mark">01</view>
      <view class="entry-icon icon-green">✦</view>
      <view class="entry-main">
        <view class="entry-title">我能来做什么</view>
        <view class="entry-desc">实习就业 · 项目参与 · 乡村运营 · 青年实践</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="entry entry-blue" data-type="实践站点" bindtap="goList">
      <view class="entry-mark">02</view>
      <view class="entry-icon icon-blue">⌂</view>
      <view class="entry-main">
        <view class="entry-title">德清能提供什么</view>
        <view class="entry-desc">实践站点 · 创业空间 · 乡村资源 · 政策机会</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>

    <view class="entry entry-orange" data-type="咨询单位" bindtap="goList">
      <view class="entry-mark">03</view>
      <view class="entry-icon icon-orange">↗</view>
      <view class="entry-main">
        <view class="entry-title">我该找谁</view>
        <view class="entry-desc">官方咨询单位 · 联系方式 · 服务入口</view>
      </view>
      <view class="entry-arrow">›</view>
    </view>
  </view>

  <view class="bottom-note">
    <view class="note-line"></view>
    <view class="note-text">让青春与乡村双向奔赴</view>
    <view class="note-line"></view>
  </view>
</view>