.page{
  min-height:100vh;
  box-sizing:border-box;
  padding:28rpx 30rpx 48rpx;
  background:#f6f7f3;
  color:#1d2a22;
}
.hero{
  position:relative;
  height:420rpx;
  overflow:hidden;
  border-radius:42rpx;
  box-sizing:border-box;
  background:#2d6948;
  box-shadow:0 18rpx 45rpx rgba(37,91,56,.18);
}
.hero-image{
  position:absolute;
  left:0;
  top:0;
  width:100%;
  height:100%;
}
.hero-overlay{
  position:absolute;
  inset:0;
  background:linear-gradient(180deg,rgba(0,30,20,.24) 0%,rgba(0,30,20,.12) 38%,rgba(0,20,12,.52) 100%);
}
.hero-content{
  position:absolute;
  left:42rpx;
  right:42rpx;
  top:48rpx;
  z-index:2;
}
.eyebrow{
  font-size:18rpx;
  letter-spacing:3rpx;
  color:rgba(255,255,255,.9);
  text-shadow:0 2rpx 8rpx rgba(0,0,0,.25);
}
.hero-title{
  margin-top:24rpx;
  font-size:72rpx;
  line-height:1;
  font-weight:700;
  letter-spacing:5rpx;
  color:#fff;
  text-shadow:0 4rpx 16rpx rgba(0,0,0,.3);
}
.hero-subtitle{
  margin-top:22rpx;
  font-size:31rpx;
  font-weight:500;
  color:#fff;
  text-shadow:0 3rpx 10rpx rgba(0,0,0,.3);
}
.hero-desc{
  margin-top:16rpx;
  font-size:23rpx;
  line-height:1.7;
  color:rgba(255,255,255,.92);
  text-shadow:0 2rpx 8rpx rgba(0,0,0,.3);
}
.hero-slogan{
  position:absolute;
  z-index:2;
  left:42rpx;
  right:42rpx;
  bottom:34rpx;
  display:flex;
  align-items:center;
  justify-content:center;
  height:62rpx;
  border-radius:31rpx;
  background:rgba(20,55,37,.38);
  border:1rpx solid rgba(255,255,255,.28);
  color:#fff;
  font-size:23rpx;
  letter-spacing:2rpx;
  text-shadow:0 2rpx 8rpx rgba(0,0,0,.25);
}
.dot{margin:0 16rpx;opacity:.7}
.section-head{margin:44rpx 8rpx 24rpx}
.section-title{font-size:36rpx;font-weight:700;letter-spacing:1rpx}
.section-desc{margin-top:9rpx;font-size:23rpx;color:#89918b}
.entry-list{display:flex;flex-direction:column;gap:20rpx}
.entry{
  position:relative;
  display:flex;
  align-items:center;
  min-height:154rpx;
  padding:26rpx 24rpx;
  box-sizing:border-box;
  border-radius:28rpx;
  border:1rpx solid rgba(30,50,38,.06);
  box-shadow:0 8rpx 25rpx rgba(34,53,42,.06);
}
.entry-green{background:#edf7ef}
.entry-blue{background:#eef5f8}
.entry-orange{background:#fff4e9}
.entry-mark{position:absolute;left:22rpx;top:18rpx;font-size:17rpx;font-weight:600;color:rgba(31,53,40,.32);letter-spacing:1rpx}
.entry-icon{flex:none;width:82rpx;height:82rpx;margin-right:22rpx;border-radius:24rpx;display:flex;align-items:center;justify-content:center;font-size:42rpx;font-weight:300}
.icon-green{background:#d9eddd;color:#37754c}
.icon-blue{background:#dcebf1;color:#39748a}
.icon-orange{background:#fbe4cc;color:#ad6b32}
.entry-main{flex:1;min-width:0}
.entry-title{font-size:32rpx;line-height:1.35;font-weight:650;color:#243329}
.entry-desc{margin-top:9rpx;padding-right:8rpx;font-size:22rpx;line-height:1.55;color:#7b847e}
.entry-arrow{flex:none;width:48rpx;height:48rpx;margin-left:12rpx;border-radius:50%;display:flex;align-items:center;justify-content:center;background:rgba(255,255,255,.72);color:#647069;font-size:40rpx;line-height:42rpx}
.bottom-note{display:flex;align-items:center;justify-content:center;margin-top:48rpx}
.note-line{width:54rpx;height:1rpx;background:#d8ddd8}
.note-text{margin:0 18rpx;color:#a0a7a2;font-size:20rpx;letter-spacing:2rpx}