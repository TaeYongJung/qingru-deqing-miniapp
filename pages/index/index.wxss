.page{padding:30rpx;background:#f7f8f5;min-height:100vh}.banner{height:360rpx;border-radius:36rpx;background:linear-gradient(135deg,#4ca86a,#9bd8a8);padding:50rpx 40rpx;color:white;box-sizing:border-box}.banner-title{font-size:64rpx;font-weight:bold}.banner-sub{font-size:34rpx;margin-top:20rpx}.banner-tip{margin-top:60rpx;background:rgba(255,255,255,.2);padding:15rpx;border-radius:30rpx;text-align:center}.entry{margin-top:28rpx;padding:35rpx;border-radius:28rpx;display:flex;align-items:center}.green{background:#e8f7eb}.blue{background:#e7f4fb}.orange{background:#fff0e4}.icon{font-size:55rpx;margin-right:25rpx}.title{display:block;font-size:36rpx;font-weight:bold}.desc{display:block;color:#666;margin-top:12rpx;font-size:26rpx}.section-title{font-size:38rpx;font-weight:bold;margin-top:45rpx}.hot-card{background:white;padding:30rpx;border-radius:25rpx;margin-top:20rpx}.hot-title{display:block;font-size:34rpx;font-weight:bold;margin-bottom:15rpx}