.page{
  padding:28rpx;
  background:#f7f8f5;
  min-height:100vh;
}
.header{display:flex;align-items:center;margin-bottom:28rpx;}
.back{font-size:56rpx;color:#333;}
.title{font-size:40rpx;font-weight:600;margin-left:20rpx;}
.search-box{display:flex;align-items:center;background:#fff;border-radius:40rpx;padding:20rpx 28rpx;}
.search-box input{flex:1;margin-left:15rpx;color:#666;}
.tabs{white-space:nowrap;margin:28rpx 0;}
.tab{display:inline-block;background:#fff;padding:14rpx 28rpx;border-radius:30rpx;margin-right:18rpx;color:#666;}
.tab.active{background:#e4f5e8;color:#218b4b;}
.list-tip{color:#888;margin:24rpx 0 20rpx;}
.contact-tip{background:#eaf6ee;border-radius:24rpx;padding:24rpx 28rpx;margin-top:24rpx;}
.contact-tip-title{font-size:30rpx;font-weight:600;color:#216d3d;}
.contact-tip-text{font-size:25rpx;color:#5c7865;line-height:1.6;margin-top:8rpx;}
.contact-card{display:flex;background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx;}
.contact-icon{width:72rpx;height:72rpx;border-radius:20rpx;background:#e8f5e9;display:flex;align-items:center;justify-content:center;font-size:34rpx;flex-shrink:0;margin-right:22rpx;}
.contact-main{flex:1;min-width:0;}
.contact-tag{margin:12rpx 0 16rpx;}
.contact-desc,.contact-target,.contact-benefit{color:#666;font-size:26rpx;line-height:1.65;margin-top:10rpx;}
.contact-target{color:#555;}
.contact-benefit{color:#39704d;}
.contact-actions{display:flex;gap:18rpx;margin-top:22rpx;}
.contact-actions button{flex:1;height:72rpx;line-height:72rpx;font-size:26rpx;border-radius:36rpx;padding:0;}
.detail-btn{background:#f0f4f1;color:#287247;}
.call-btn{background:#35a854;color:#fff;}
.card{background:#fff;border-radius:28rpx;padding:28rpx;margin-bottom:24rpx;}
.card-main{display:flex;justify-content:space-between;}
.card-left{flex:1;}
.card-title{font-size:34rpx;font-weight:bold;color:#222;}
.tag{display:inline-block;margin:16rpx 0;background:#e8f5e9;color:#27894c;padding:8rpx 18rpx;border-radius:20rpx;font-size:24rpx;}
.location,.desc{color:#666;font-size:28rpx;margin-top:12rpx;}
.status{margin-top:18rpx;color:#24924d;font-size:24rpx;}
.image-box{width:150rpx;height:150rpx;background:#dcebdc;border-radius:18rpx;display:flex;align-items:center;justify-content:center;color:#59936b;}
.empty{text-align:center;color:#999;padding:40rpx;}