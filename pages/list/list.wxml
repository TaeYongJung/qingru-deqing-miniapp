<view class="page">
  <view class="header">
    <view class="back">‹</view>
    <view class="title">{{pageTitle}}</view>
  </view>

  <view class="search-box">
    <text class="search-icon">🔍</text>
    <input placeholder="{{isContact ? '搜索单位、就业、创业、文旅、农业等关键词' : '搜索关键词，如：电商、文创、实践站点'}}" bindinput="search" />
  </view>

  <view wx:if="{{isContact}}" class="contact-tip">
    <view class="contact-tip-title">不知道该找哪个部门？</view>
    <view class="contact-tip-text">按你的需求选择对应单位，查看咨询方向和联系方式。</view>
  </view>

  <scroll-view wx:if="{{!isContact}}" scroll-x class="tabs" enable-flex>
    <view class="tab active">全部</view>
    <view class="tab">实践站点</view>
    <view class="tab">实习/就业</view>
    <view class="tab">项目机会</view>
    <view class="tab">比赛</view>
  </scroll-view>

  <view class="list-tip">{{isContact ? '官方咨询单位' : '发现适合青年入乡的机会'}}</view>

  <block wx:for="{{cards}}" wx:key="id">
    <view wx:if="{{isContact}}" class="contact-card">
      <view class="contact-icon">🤝</view>
      <view class="contact-main">
        <view class="card-title">{{item.title}}</view>
        <text class="tag contact-tag">官方单位</text>
        <view class="contact-desc">{{item.desc}}</view>
        <view class="contact-target">适合咨询：{{item.target}}</view>
        <view class="contact-benefit">可咨询：{{item.benefit}}</view>
        <view class="contact-actions">
          <button class="detail-btn" data-id="{{item.id}}" bindtap="openDetail">查看详情</button>
          <button wx:if="{{item.phone && item.phone.match && false}}" class="call-btn">联系</button>
          <button wx:else class="call-btn" data-phone="{{item.phone}}" bindtap="callPhone">电话咨询</button>
        </view>
      </view>
    </view>

    <view wx:else class="card" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-main">
        <view class="card-left">
          <view class="card-title">{{item.title}}</view>
          <text class="tag">{{item.type}}</text>
          <view class="location">📍 {{item.location}}</view>
          <view class="desc">{{item.desc}}</view>
          <view class="status">{{item.status}}</view>
        </view>
        <view class="image-box">机会</view>
      </view>
    </view>
  </block>

  <view wx:if="{{cards.length === 0}}" class="empty">没有找到相关内容</view>
</view>