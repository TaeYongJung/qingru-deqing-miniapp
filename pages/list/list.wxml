<view class="page">
  <view class="title">我能来做什么</view>
  <input class="search" placeholder="搜索机会" bindinput="search" />
  <view class="tabs">全部　实践站点　实习　项目</view>
  <block wx:for="{{cards}}" wx:key="id">
    <view class="card" data-id="{{item.id}}" bindtap="openDetail">
      <view class="card-title">{{item.title}}</view>
      <text class="tag">{{item.type}}</text>
      <view>📍 {{item.location}}</view>
      <view class="desc">{{item.desc}}</view>
      <text>{{item.status}}</text>
    </view>
  </block>
</view>
